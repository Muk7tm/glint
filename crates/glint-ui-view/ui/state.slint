// SPDX-License-Identifier: MIT
// State shared between Rust and the window, the way Pulse does it: Rust owns all the logic, and
// the .slint side only shows these values and reports what the user did.

import { Tone } from "pulse/components.slint";
import { Cell, Chip } from "widgets.slint";

export global Ui {
    in property <string> version;
    // Connected to the engine.
    in property <bool> connected;
    // A warning over the whole window (XWayland).
    in property <string> banner;

    // The hero card.
    in property <string> button-text: "▶  Start";
    in property <bool> button-enabled;
    in property <bool> button-danger;
    in property <string> hint;
    in property <Tone> hint-tone: Tone.neutral;
    // One line for short-lived messages, so the layout never jumps.
    in property <string> toast;
    in property <Tone> toast-tone: Tone.warning;

    // The current hotkeys, for the close dialog's wording.
    in property <string> start-key: "F7";
    in property <string> stop-key: "F8";

    in-out property <bool> more-open;
    // The diagnostics text the window copies to the clipboard.
    in property <string> diagnostics;
}

export global Form {
    // Locked while disconnected.
    in property <bool> editable: true;

    // COLOR
    in property <bool> has-color;
    in property <color> color;
    in-out property <string> color-hex;
    in-out property <int> shades-index: 1;
    in property <bool> seeing-known;
    in property <color> seeing-color;
    in property <string> seeing-text: "Not watching";
    // Picking a color: the magnifier shows the pixels around the pointer.
    in property <bool> picking-color;
    in property <image> magnifier;
    in property <bool> magnifier-ready;
    in-out property <int> watch-index;
    in property <string> watch-note;

    // CLICKING
    in-out property <int> click-index;
    in property <string> key-name;
    in property <[string]> key-names;
    in property <int> key-index;
    in-out property <int> hold-ms: 10;
    in-out property <int> mode-index;
    in property <string> hotkey: "F7";
    in property <[string]> hotkey-names;
    in property <int> hotkey-index;
    in property <string> emergency: "F8";
    in property <string> err-key;
    // Asks for the key while *Keyboard key* has none yet.
    in property <string> key-hint;
    in property <string> err-hotkey;
    in-out property <bool> capture-hotkeys;
    in property <string> err-general;

    // GAME WINDOW
    in property <string> window-name;
    in property <string> window-state;
    in property <Tone> window-tone: Tone.neutral;
    in-out property <bool> only-in-window: true;
    in property <bool> picking;

    // More options → DETECTION
    in-out property <int> pattern-index: 2;
    in-out property <int> must-match: 5;
    in property <int> pattern-pixels: 9;
    in-out property <int> speed-index: 1;
    in property <string> speed-text: "2,000/sec";
    in-out property <int> gone-after: 40;
    in-out property <int> min-gap: 25;
    in-out property <int> safety-stop: 15;
    in-out property <int> backend-index;
    in property <string> backend-now;
    in-out property <int> offset-x;
    in-out property <int> offset-y;

    // More options → COLOR RANGE: the model, the main color's three tolerances (labels and
    // limits per model; RGB has one), the strips, the lists, the color to check, and recording.
    in-out property <int> model-index;
    in-out property <int> tol-a;
    in-out property <int> tol-b;
    in-out property <int> tol-c;
    in property <string> tol-a-label: "Lightness ±";
    in property <string> tol-b-label: "Colorfulness ±";
    in property <string> tol-c-label: "Hue ±";
    in property <string> tol-a-unit;
    in property <string> tol-c-unit: "degrees";
    in property <int> tol-a-max: 100;
    in property <int> tol-b-max: 50;
    in property <int> tol-c-max: 180;
    in property <bool> tol-b-shown: true;
    in property <[Cell]> shade-strip;
    in property <[Cell]> hue-strip;
    in property <[Chip]> also-match;
    in property <[Chip]> never-match;
    in-out property <string> check-hex;
    in property <bool> check-known;
    in property <color> check-color;
    in property <string> check-text;
    in property <Tone> check-tone: Tone.neutral;
    in property <bool> recording;
    in property <[Chip]> recorded;
    in property <string> sample-key: "F6";

    // More options → ENGINE
    in-out property <int> closing-index;
    in-out property <bool> start-at-login;
    in property <string> realtime-text;
    in property <string> response-text: "not watching";
    in property <bool> latency-running;
    in property <string> latency-text;
    in property <[string]> profile-names;
    in-out property <int> profile-index;
}

export global Actions {
    callback main-button();
    callback form-changed();
    callback pick-color();
    callback hex-entered(string);
    callback cancel-pick();
    callback key-captured(string);
    callback key-chosen(string);
    callback hotkey-captured(string);
    callback hotkey-chosen(string);
    callback pick-window();
    callback more-toggled();
    callback close-window();
    // COLOR RANGE
    callback check-hex(string);
    callback add-also();
    callback add-never();
    callback remove-also(int);
    callback remove-never(int);
    callback record();
    callback choose-recorded(int);
    callback sample-for-check();
    // ENGINE
    callback start-at-login-toggled();
    callback latency-test();
    callback use-profile(int);
    callback copy-diagnostics();
    callback import-profile();
    callback export-profile();
}
