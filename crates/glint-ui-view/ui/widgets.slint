// SPDX-License-Identifier: MIT
// Glint's own pieces, in Pulse's style (PLAN §12.6): the swatch, and the color field built on it.

import { Theme } from "pulse/theme.slint";

// 16 × 16 px, radius 3, a 1 px border so dark colors stay visible.
export component Swatch inherits Rectangle {
    in property <color> value;
    width: 16px;
    height: 16px;
    border-radius: 3px;
    border-width: 1px;
    border-color: Theme.border-strong;
    background: root.value;
}

// The color field: its swatch, and its hex value, which can be typed (Enter applies it).
export component ColorField inherits Rectangle {
    in property <bool> empty;
    in property <color> value;
    in-out property <string> hex;
    in property <bool> enabled: true;
    callback entered(string);
    width: 160px;
    height: Theme.control-height;
    border-radius: Theme.radius-s;
    background: Theme.elevated;
    border-width: 1px;
    border-color: input.has-focus ? Theme.focus-ring : Theme.border;
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: Theme.gap-s;
        if !root.empty: Swatch {
            value: root.value;
        }
        Rectangle {
            input := TextInput {
                width: 100%;
                height: 100%;
                text <=> root.hex;
                enabled: root.enabled;
                single-line: true;
                color: Theme.text;
                vertical-alignment: center;
                font-size: Theme.font-body;
                accessible-label: "Color as a hex code";
                accepted => {
                    root.entered(self.text);
                    self.clear-focus();
                }
            }

            if input.text == "": Text {
                x: 0;
                text: "#RRGGBB";
                color: Theme.text-muted;
                vertical-alignment: center;
                height: 100%;
            }
        }
    }
}

// The magnifier (§12.6): 11 × 11 screen pixels at ×8, the center cell outlined in white.
export component Magnifier inherits Rectangle {
    in property <image> source;
    in property <bool> ready;
    width: 90px;
    height: 90px;
    border-width: 1px;
    border-color: Theme.border-strong;
    background: Theme.elevated;
    clip: true;
    if root.ready: Image {
        x: 1px;
        y: 1px;
        width: 88px;
        height: 88px;
        source: root.source;
        image-rendering: pixelated;
    }
    Rectangle {
        x: 1px + 40px;
        y: 1px + 40px;
        width: 8px;
        height: 8px;
        border-width: 1px;
        border-color: #FFFFFF;
    }
}

// One cell of a shade or hue strip (§12.4): its color, and what the engine counts it as:
// 2 starts an appearance, 1 keeps one going, 0 neither.
export struct Cell {
    color: color,
    level: int,
}

// A shade or hue strip: 16 cells; matching cells at full color, the rest dimmed to 25% (§12.6).
export component Strip inherits HorizontalLayout {
    in property <[Cell]> cells;
    spacing: 2px;
    for cell in root.cells: Rectangle {
        width: 13px;
        height: 16px;
        border-radius: 2px;
        background: cell.color;
        opacity: cell.level == 2 ? 1.0 : cell.level == 1 ? 0.55 : 0.25;
    }
}

// A color in a list: its swatch and hex, and an × to remove it.
export struct Chip {
    color: color,
    hex: string,
}

export component ChipRow inherits HorizontalLayout {
    in property <[Chip]> chips;
    in property <bool> enabled: true;
    callback remove(int);
    spacing: Theme.gap-s;
    alignment: start;
    for chip[i] in root.chips: Rectangle {
        height: 22px;
        width: row.preferred-width + 8px;
        border-radius: Theme.radius-s;
        background: Theme.elevated;
        border-width: 1px;
        border-color: Theme.border;
        row := HorizontalLayout {
            x: 4px;
            spacing: 4px;
            alignment: start;
            Swatch {
                y: 3px;
                value: chip.color;
            }

            Text {
                text: chip.hex;
                color: Theme.text;
                font-size: Theme.font-caption;
                vertical-alignment: center;
            }

            Text {
                text: "×";
                color: x-touch.has-hover ? Theme.text : Theme.text-muted;
                vertical-alignment: center;
                x-touch := TouchArea {
                    enabled: root.enabled;
                    clicked => {
                        root.remove(i);
                    }
                }
            }
        }
    }
}

// Recorded colors (§12.9): swatches to click, most frequent first.
export component SwatchRow inherits HorizontalLayout {
    in property <[Chip]> chips;
    callback chosen(int);
    spacing: 4px;
    alignment: start;
    for chip[i] in root.chips: Rectangle {
        width: 18px;
        height: 18px;
        border-radius: 3px;
        border-width: 1px;
        border-color: touch.has-hover ? Theme.text : Theme.border-strong;
        background: chip.color;
        accessible-role: AccessibleRole.button;
        accessible-label: chip.hex;
        touch := TouchArea {
            clicked => {
                root.chosen(i);
            }
        }
    }
}
