// Glint's own pieces, in Pulse's style (PLAN §12.6): the swatch, and the color field built on it.

import { Theme } from "pulse/theme.slint";

// 16 × 16 px, radius 3, a 1 px border so dark colors stay visible.
export component Swatch inherits Rectangle {
    in property <color> value;
    width: 16px;
    height: 16px;
    border-radius: 3px;
    border-width: 1px;
    border-color: Theme.border-strong;
    background: root.value;
}

// The color field: its swatch, and its hex value, which can be typed (Enter applies it).
export component ColorField inherits Rectangle {
    in property <bool> empty;
    in property <color> value;
    in-out property <string> hex;
    in property <bool> enabled: true;
    callback entered(string);
    width: 160px;
    height: Theme.control-height;
    border-radius: Theme.radius-s;
    background: Theme.elevated;
    border-width: 1px;
    border-color: input.has-focus ? Theme.focus-ring : Theme.border;
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: Theme.gap-s;
        if !root.empty: Swatch {
            value: root.value;
        }
        Rectangle {
            input := TextInput {
                width: 100%;
                height: 100%;
                text <=> root.hex;
                enabled: root.enabled;
                single-line: true;
                color: Theme.text;
                vertical-alignment: center;
                font-size: Theme.font-body;
                accessible-label: "Color as a hex code";
                accepted => {
                    root.entered(self.text);
                    self.clear-focus();
                }
            }

            if input.text == "": Text {
                x: 0;
                text: "#RRGGBB";
                color: Theme.text-muted;
                vertical-alignment: center;
                height: 100%;
            }
        }
    }
}

// The magnifier (§12.6): 11 × 11 screen pixels at ×8, the center cell outlined in white.
export component Magnifier inherits Rectangle {
    in property <image> source;
    in property <bool> ready;
    width: 90px;
    height: 90px;
    border-width: 1px;
    border-color: Theme.border-strong;
    background: Theme.elevated;
    clip: true;
    if root.ready: Image {
        x: 1px;
        y: 1px;
        width: 88px;
        height: 88px;
        source: root.source;
        image-rendering: pixelated;
    }
    Rectangle {
        x: 1px + 40px;
        y: 1px + 40px;
        width: 8px;
        height: 8px;
        border-width: 1px;
        border-color: #FFFFFF;
    }
}
