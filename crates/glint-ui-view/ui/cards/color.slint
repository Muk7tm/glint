// COLOR (PLAN §12.3): what to watch for, and the live swatch of what the engine sees.

import { Theme } from "../pulse/theme.slint";
import { PButton, ButtonKind, Card, Note, Segmented, FieldRow } from "../pulse/components.slint";
import { Form, Actions } from "../state.slint";
import { Swatch, ColorField, Magnifier } from "../widgets.slint";

export component ColorCard inherits Card {
    title: "COLOR";
    FieldRow {
        label: "Color";
        ColorField {
            empty: !Form.has-color;
            value: Form.color;
            hex <=> Form.color-hex;
            enabled: Form.editable;
            entered(text) => {
                Actions.hex-entered(text);
            }
        }

        PButton {
            text: Form.picking-color ? "Picking…" : "Pick";
            enabled: Form.editable && !Form.picking-color;
            clicked => {
                Actions.pick-color();
            }
        }
    }

    if Form.picking-color: HorizontalLayout {
        padding-left: Theme.label-width + Theme.gap-s;
        spacing: Theme.gap-m;
        Magnifier {
            source: Form.magnifier;
            ready: Form.magnifier-ready;
        }

        VerticalLayout {
            alignment: center;
            spacing: Theme.gap-xs;
            Text {
                text: "Click the color you want.";
                color: Theme.text;
            }

            Text {
                text: "Esc or a right click cancels.";
                color: Theme.text-muted;
                font-size: Theme.font-caption;
            }

            HorizontalLayout {
                alignment: start;
                padding-top: Theme.gap-xs;
                PButton {
                    text: "Cancel";
                    kind: ButtonKind.ghost;
                    clicked => {
                        Actions.cancel-pick();
                    }
                }
            }
        }
    }

    FieldRow {
        label: "Shades";
        Segmented {
            width: 220px;
            options: ["Tight", "Normal", "Loose", "Loose+"];
            current <=> Form.shades-index;
            enabled: Form.editable && Form.has-color;
            changed => {
                Actions.form-changed();
            }
        }
    }

    FieldRow {
        label: "Seeing";
        if Form.seeing-known: Swatch {
            value: Form.seeing-color;
        }
        Text {
            text: Form.seeing-text;
            color: Form.seeing-known ? Theme.text : Theme.text-muted;
            vertical-alignment: center;
            overflow: elide;
        }
    }

    FieldRow {
        label: "Watch";
        warning: Form.watch-note;
        Segmented {
            width: 240px;
            options: ["Screen center", "Window center"];
            current <=> Form.watch-index;
            enabled: Form.editable;
            changed => {
                Actions.form-changed();
            }
        }
    }
}
