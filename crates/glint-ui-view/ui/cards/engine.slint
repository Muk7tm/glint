// More options → ENGINE (PLAN §12.4): the close policy, starting at login, the hot thread's
// priority, live response numbers, the latency test, the active profile, diagnostics, and
// importing or exporting a profile.

import { Theme } from "../pulse/theme.slint";
import { Card, Segmented, FieldRow, PButton, Select, Toggle, Note, Tone } from "../pulse/components.slint";
import { Form, Actions } from "../state.slint";

component Value inherits Text {
    color: Theme.text-secondary;
    font-size: Theme.font-caption;
    vertical-alignment: center;
    overflow: elide;
}

export component EngineCard inherits Card {
    title: "ENGINE";
    FieldRow {
        label: "When closing";
        Segmented {
            width: 240px;
            options: ["Ask", "Keep running", "Quit"];
            current <=> Form.closing-index;
            enabled: Form.editable;
            changed => {
                Actions.form-changed();
            }
        }
    }

    // Not an engine setting: the window writes or removes an autostart entry (PLAN §18), so it
    // works while the engine is away too.
    Toggle {
        text: "Start the engine when I log in";
        checked <=> Form.start-at-login;
        toggled => {
            Actions.start-at-login-toggled();
        }
    }

    if Form.start-at-login: Note {
        width: root.width - 2 * Theme.card-padding;
        message: "It starts without the window and waits for your start key.";
        tone: Tone.neutral;
    }

    FieldRow {
        label: "Real-time";
        Value {
            text: Form.realtime-text;
        }
    }

    FieldRow {
        label: "Response";
        Value {
            text: Form.response-text;
        }
    }

    FieldRow {
        label: "Latency test";
        PButton {
            text: Form.latency-running ? "Running…" : "Run";
            enabled: !Form.latency-running;
            clicked => {
                Actions.latency-test();
            }
        }

        Value {
            text: Form.latency-running ? "about a minute…" : "in a test X server";
        }
    }

    if Form.latency-text != "": HorizontalLayout {
        padding-left: Theme.label-width + Theme.gap-s;
        Value {
            text: Form.latency-text;
            wrap: word-wrap;
        }
    }

    FieldRow {
        label: "Profile";
        Select {
            width: 200px;
            name: "Profile";
            model: Form.profile-names;
            current-index <=> Form.profile-index;
            enabled: Form.editable;
            open-upward: true;
            selected(i) => {
                Actions.use-profile(i);
            }
        }
    }

    HorizontalLayout {
        spacing: Theme.gap-s;
        alignment: start;
        PButton {
            text: "Copy diagnostics";
            enabled: Form.editable;
            clicked => {
                Actions.copy-diagnostics();
            }
        }

        PButton {
            text: "Import";
            enabled: Form.editable;
            clicked => {
                Actions.import-profile();
            }
        }

        PButton {
            text: "Export";
            enabled: Form.editable;
            clicked => {
                Actions.export-profile();
            }
        }
    }
}
