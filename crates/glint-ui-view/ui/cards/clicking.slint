// CLICKING (PLAN §12.3): Pulse's rows and wording, except Mode says "Hold to watch": Glint
// watches while the key is held and stops the moment it's released (ADR 0013).

import { Theme } from "../pulse/theme.slint";
import { Card, Note, Tone, Segmented, Select, KeyField, NumberField, FieldRow, Toggle } from "../pulse/components.slint";
import { Form, Actions } from "../state.slint";

export component ClickingCard inherits Card {
    title: "CLICKING";
    FieldRow {
        label: "Click";
        error: Form.err-key;
        warning: Form.key-hint;
        Select {
            width: Form.click-index == 5 ? 128px : 160px;
            name: "What to click";
            model: ["Left click", "Right click", "Middle click", "Back button", "Forward button", "Keyboard key"];
            current-index <=> Form.click-index;
            enabled: Form.editable;
            selected => {
                Actions.form-changed();
            }
        }

        if Form.click-index == 5: KeyField {
            width: 100px;
            name: "Key to press";
            key-name: Form.key-name;
            key-names: Form.key-names;
            key-index: Form.key-index;
            enabled: Form.editable;
            captured(text) => {
                Actions.key-captured(text);
            }
            chosen(name) => {
                Actions.key-chosen(name);
            }
        }
    }

    FieldRow {
        label: "Hold (ms)";
        NumberField {
            value <=> Form.hold-ms;
            minimum: 0;
            maximum: 200;
            enabled: Form.editable;
            edited => {
                Actions.form-changed();
            }
        }

        Text {
            text: Form.hold-ms == 0 ? "instant click" : "released after " + Form.hold-ms + " ms";
            color: Theme.text-muted;
            font-size: Theme.font-caption;
            vertical-alignment: center;
        }
    }

    FieldRow {
        label: "Mode";
        Segmented {
            width: 220px;
            options: ["Press to toggle", "Hold to watch"];
            current <=> Form.mode-index;
            enabled: Form.editable;
            changed => {
                Actions.form-changed();
            }
        }
    }

    FieldRow {
        label: "Start/stop key";
        error: Form.err-hotkey;
        hotkey-field := KeyField {
            width: 100px;
            name: "Start and stop key";
            key-name: Form.hotkey;
            key-names: Form.hotkey-names;
            key-index: Form.hotkey-index;
            side-buttons: true;
            enabled: Form.editable;
            captured(text) => {
                Actions.hotkey-captured(text);
            }
            chosen(name) => {
                Actions.hotkey-chosen(name);
            }
        }

        Text {
            text: hotkey-field.capturing ? "or click a side button" : "Emergency stop: " + Form.emergency;
            color: Theme.text-secondary;
            font-size: Theme.font-caption;
            vertical-alignment: center;
        }
    }

    // fire_if_present_on_start (ADR 0023): only a start the user makes; restarts never click.
    Toggle {
        text: "Click if it's already there when I start";
        checked <=> Form.fire-on-start;
        enabled: Form.editable;
        toggled => {
            Actions.form-changed();
        }
    }

    // A mouse click lands at the pointer, which is on this window when Start is pressed here.
    if Form.fire-on-start: Note {
        width: root.width - 2 * Theme.card-padding;
        message: Form.click-index == 5
            ? "Only when you start it. For the next click, the color has to leave and come back."
            : "Only when you start it. Start with your key: from the Start button, that click would land on this window.";
        tone: Tone.neutral;
    }

    // Capture mode (§9): the game doesn't get the hotkeys.
    Toggle {
        text: "Keep the hotkeys from the game";
        checked <=> Form.capture-hotkeys;
        enabled: Form.editable;
        toggled => {
            Actions.form-changed();
        }
    }

    if Form.capture-hotkeys: Note {
        width: root.width - 2 * Theme.card-padding;
        message: "They don't work while another program holds the whole keyboard.";
        tone: Tone.warning;
    }

    if Form.err-general != "": Note {
        width: root.width - 2 * Theme.card-padding;
        message: Form.err-general;
        tone: Tone.error;
    }
}
