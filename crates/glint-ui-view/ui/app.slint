// SPDX-License-Identifier: MIT
// The Glint window (PLAN §12.3): Pulse's shell and cards, Glint's COLOR card under the hero. The
// shared components are the copy in pulse/ (ADR 0012); the state is in state.slint. The About
// button and dialog are Pulse's (crates/pulse-ui/ui/main.slint at e4ccdaa, MIT) with Glint's name;
// its AboutSlint meets the condition of Slint's royalty-free license (ADR 0016).

import { ScrollView, AboutSlint } from "std-widgets.slint";
import { Theme } from "pulse/theme.slint";
import { PButton, ButtonKind, Disclosure, Note, Tone } from "pulse/components.slint";
import { Ui, Form, Actions } from "state.slint";
import { HeroCard } from "cards/hero.slint";
import { ColorCard } from "cards/color.slint";
import { ClickingCard } from "cards/clicking.slint";
import { WindowCard } from "cards/window.slint";
import { DetectionCard } from "cards/detection.slint";
import { RangeCard } from "cards/range.slint";
import { EngineCard } from "cards/engine.slint";

export { Ui, Form, Actions, Tone }

export component AppWindow inherits Window {
    title: "Glint";
    // The same icon as the apps-menu entry (PLAN §18).
    icon: @image-url("../../../assets/glint.svg");
    // Two columns of cards (ADR 0027): each at least 360 px, the width Pulse's cards were made for.
    preferred-width: 780px;
    preferred-height: root.fit-height;
    min-width: 760px;
    min-height: 360px;
    background: Theme.bg;
    default-font-size: Theme.font-body;

    callback keep-running();
    callback quit-app();
    // Asks the Rust side to make the window this size (ADR 0027).
    callback fit(length, length);

    // The height that shows the main cards and the *More options* line without scrolling; the More
    // options cards scroll below them, so opening them doesn't change it (ADR 0027). The window
    // follows it: when it's first laid out, and when a warning appears or the cards' text rewraps.
    out property <length> fit-height: Theme.gap-m * 3 + main.preferred-height + footer.preferred-height + (Ui.banner != "" ? 28px : 0px);
    changed fit-height => {
        // Until the window manager gives the window its first size, Slint reports the minimum; the
        // preferred size applies then.
        if root.width > root.min-width || root.height > root.min-height {
            root.fit(root.width, self.fit-height);
        }
    }
    // One column: half the cards' width, minus the scrollbar's gutter and the gap between columns.
    property <length> column: max(360px, (scroll.visible-width - 10px - Theme.gap-s) / 2);

    // *Copy diagnostics* (§12.4): Slint copies to the clipboard from a text input, so an invisible
    // one holds the text.
    diagnostics-text := TextInput {
        x: 0;
        y: 0;
        width: 0px;
        height: 0px;
        opacity: 0;
        read-only: true;
        text: Ui.diagnostics;
    }

    public function copy-diagnostics() {
        diagnostics-text.select-all();
        diagnostics-text.copy();
        diagnostics-text.clear-selection();
    }

    VerticalLayout {
        padding-left: Theme.gap-l;
        // The scroll area keeps a 10 px gutter for its scrollbar; the footer adds the same.
        padding-right: 6px;
        padding-top: Theme.gap-m;
        padding-bottom: Theme.gap-m;
        spacing: Theme.gap-m;

        if Ui.banner != "": Note {
            message: Ui.banner;
            tone: Tone.warning;
        }

        scroll := ScrollView {
            vertical-stretch: 1;
            content-width: self.visible-width;
            cards := VerticalLayout {
                width: scroll.visible-width;
                padding-right: 10px;
                spacing: Theme.gap-s;
                alignment: start;
                // Two cards to a row, sharing its height (ADR 0027): starting beside the game
                // window, then the color beside the clicking. Each More options card sits under
                // the main card it belongs with. The window's height fits the part always shown;
                // the More options cards below it scroll.
                main := VerticalLayout {
                    spacing: Theme.gap-s;
                    HorizontalLayout {
                        spacing: Theme.gap-s;
                        HeroCard {
                            width: root.column;
                        }

                        WindowCard {
                            width: root.column;
                        }
                    }

                    HorizontalLayout {
                        spacing: Theme.gap-s;
                        ColorCard {
                            width: root.column;
                        }

                        ClickingCard {
                            width: root.column;
                        }
                    }

                    Disclosure {
                        text: "More options";
                        open <=> Ui.more-open;
                        toggled => {
                            Actions.more-toggled();
                        }
                    }
                }

                if Ui.more-open: HorizontalLayout {
                    spacing: Theme.gap-s;
                    RangeCard {
                        width: root.column;
                    }

                    DetectionCard {
                        width: root.column;
                    }
                }

                if Ui.more-open: HorizontalLayout {
                    alignment: start;
                    EngineCard {
                        width: root.column;
                    }
                }
            }
        }

        footer := HorizontalLayout {
            padding-right: 10px;
            spacing: Theme.gap-s;
            Text {
                text: "Settings save automatically.";
                color: Theme.text-muted;
                font-size: Theme.font-caption;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }

            PButton {
                text: "About";
                kind: ButtonKind.ghost;
                clicked => {
                    about.show();
                }
            }

            PButton {
                text: "Quit Glint";
                clicked => {
                    Actions.close-window();
                }
            }
        }
    }

    about := PopupWindow {
        x: (root.width - 300px) / 2;
        y: 64px;
        width: 300px;
        close-policy: PopupClosePolicy.close-on-click-outside;
        Rectangle {
            background: Theme.elevated;
            border-radius: Theme.radius-m;
            border-width: 1px;
            border-color: Theme.border-strong;
            drop-shadow-blur: 16px;
            drop-shadow-color: #00000080;
            // Takes keyboard focus when the popup opens so Escape closes it.
            FocusScope {
                width: 0px;
                height: 0px;
                init => {
                    self.focus();
                }
                key-pressed(event) => {
                    if (event.text == Key.Escape) {
                        about.close();
                        return accept;
                    }
                    return reject;
                }
            }

            VerticalLayout {
                padding: Theme.gap-l;
                spacing: Theme.gap-s;
                Text {
                    text: "Glint " + Ui.version;
                    color: Theme.text;
                    font-size: Theme.font-title;
                    font-weight: 700;
                }

                Text {
                    text: "A low-latency, color-triggered clicker for Linux (X11). No telemetry, no network access.";
                    color: Theme.text-secondary;
                    font-size: Theme.font-caption;
                    wrap: word-wrap;
                }

                Text {
                    text: "License: MIT.";
                    color: Theme.text-secondary;
                    font-size: Theme.font-caption;
                    wrap: word-wrap;
                }

                AboutSlint {
                    height: 110px;
                }

                HorizontalLayout {
                    alignment: end;
                    PButton {
                        text: "Close";
                        clicked => {
                            about.close();
                        }
                    }
                }
            }
        }
    }

    close-prompt := PopupWindow {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        close-policy: PopupClosePolicy.no-auto-close;
        Rectangle {
            width: root.width;
            height: root.height;
            background: #000000A0;
            // Blocks clicks on the dimmed window behind the dialog.
            TouchArea { }

            FocusScope {
                width: 0px;
                height: 0px;
                init => {
                    self.focus();
                }
                key-pressed(event) => {
                    if (event.text == Key.Escape) {
                        close-prompt.close();
                        return accept;
                    }
                    return reject;
                }
            }

            Rectangle {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 336px;
                height: prompt.preferred-height;
                background: Theme.elevated;
                border-radius: Theme.radius-m;
                border-width: 1px;
                border-color: Theme.border-strong;
                drop-shadow-blur: 16px;
                drop-shadow-color: #00000080;
                prompt := VerticalLayout {
                    padding: Theme.gap-l;
                    spacing: Theme.gap-s;
                    Text {
                        text: "Close Glint?";
                        color: Theme.text;
                        font-size: Theme.font-title;
                        font-weight: 700;
                    }

                    Text {
                        text: "Keep it running in the background so " + Ui.start-key + " and " + Ui.stop-key + " keep working, or quit it completely.";
                        color: Theme.text-secondary;
                        wrap: word-wrap;
                    }

                    Text {
                        text: "You can open this window again from the apps menu.";
                        color: Theme.text-muted;
                        font-size: Theme.font-caption;
                        wrap: word-wrap;
                    }

                    HorizontalLayout {
                        alignment: end;
                        spacing: Theme.gap-s;
                        padding-top: Theme.gap-s;
                        PButton {
                            text: "Cancel";
                            kind: ButtonKind.ghost;
                            clicked => {
                                close-prompt.close();
                            }
                        }

                        PButton {
                            text: "Keep running";
                            clicked => {
                                close-prompt.close();
                                root.keep-running();
                            }
                        }

                        PButton {
                            text: "Quit Glint";
                            kind: ButtonKind.primary;
                            clicked => {
                                close-prompt.close();
                                root.quit-app();
                            }
                        }
                    }
                }
            }
        }
    }

    // Called from Rust when the window manager asks to close the window, and by
    // the footer button.
    public function ask-before-closing() {
        close-prompt.show();
    }
}
