// The Glint window (PLAN §12.3): Pulse's shell and cards, Glint's COLOR card under the hero. The
// shared components are the copy in pulse/ (ADR 0012); the state is in state.slint.

import { ScrollView } from "std-widgets.slint";
import { Theme } from "pulse/theme.slint";
import { PButton, ButtonKind, Disclosure, Tone } from "pulse/components.slint";
import { Ui, Form, Actions } from "state.slint";
import { HeroCard } from "cards/hero.slint";
import { ColorCard } from "cards/color.slint";
import { ClickingCard } from "cards/clicking.slint";
import { WindowCard } from "cards/window.slint";
import { EngineCard } from "cards/engine.slint";

export { Ui, Form, Actions, Tone }

export component AppWindow inherits Window {
    title: "Glint";
    preferred-width: 400px;
    preferred-height: 720px;
    min-width: 380px;
    min-height: 520px;
    background: Theme.bg;
    default-font-size: Theme.font-body;

    callback keep-running();
    callback quit-app();

    VerticalLayout {
        padding-left: Theme.gap-l;
        // The scroll area keeps a 10 px gutter for its scrollbar; the footer adds the same.
        padding-right: 6px;
        padding-top: Theme.gap-m;
        padding-bottom: Theme.gap-m;
        spacing: Theme.gap-m;

        scroll := ScrollView {
            vertical-stretch: 1;
            content-width: self.visible-width;
            VerticalLayout {
                width: scroll.visible-width;
                padding-right: 10px;
                spacing: Theme.gap-s;
                alignment: start;
                HeroCard { }

                ColorCard { }

                ClickingCard { }

                WindowCard { }

                Disclosure {
                    text: "More options";
                    open <=> Ui.more-open;
                    toggled => {
                        Actions.more-toggled();
                    }
                }

                if Ui.more-open: EngineCard { }
            }
        }

        HorizontalLayout {
            padding-right: 10px;
            spacing: Theme.gap-s;
            Text {
                text: "Settings save automatically.";
                color: Theme.text-muted;
                font-size: Theme.font-caption;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }

            PButton {
                text: "Quit Glint";
                clicked => {
                    Actions.close-window();
                }
            }
        }
    }

    close-prompt := PopupWindow {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        close-policy: PopupClosePolicy.no-auto-close;
        Rectangle {
            width: root.width;
            height: root.height;
            background: #000000A0;
            // Blocks clicks on the dimmed window behind the dialog.
            TouchArea { }

            FocusScope {
                width: 0px;
                height: 0px;
                init => {
                    self.focus();
                }
                key-pressed(event) => {
                    if (event.text == Key.Escape) {
                        close-prompt.close();
                        return accept;
                    }
                    return reject;
                }
            }

            Rectangle {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 336px;
                height: prompt.preferred-height;
                background: Theme.elevated;
                border-radius: Theme.radius-m;
                border-width: 1px;
                border-color: Theme.border-strong;
                drop-shadow-blur: 16px;
                drop-shadow-color: #00000080;
                prompt := VerticalLayout {
                    padding: Theme.gap-l;
                    spacing: Theme.gap-s;
                    Text {
                        text: "Close Glint?";
                        color: Theme.text;
                        font-size: Theme.font-title;
                        font-weight: 700;
                    }

                    Text {
                        text: "Keep it running in the background so " + Ui.start-key + " and " + Ui.stop-key + " keep working, or quit it completely.";
                        color: Theme.text-secondary;
                        wrap: word-wrap;
                    }

                    Text {
                        text: "You can open this window again from the apps menu.";
                        color: Theme.text-muted;
                        font-size: Theme.font-caption;
                        wrap: word-wrap;
                    }

                    HorizontalLayout {
                        alignment: end;
                        spacing: Theme.gap-s;
                        padding-top: Theme.gap-s;
                        PButton {
                            text: "Cancel";
                            kind: ButtonKind.ghost;
                            clicked => {
                                close-prompt.close();
                            }
                        }

                        PButton {
                            text: "Keep running";
                            clicked => {
                                close-prompt.close();
                                root.keep-running();
                            }
                        }

                        PButton {
                            text: "Quit Glint";
                            kind: ButtonKind.primary;
                            clicked => {
                                close-prompt.close();
                                root.quit-app();
                            }
                        }
                    }
                }
            }
        }
    }

    // Called from Rust when the window manager asks to close the window, and by
    // the footer button.
    public function ask-before-closing() {
        close-prompt.show();
    }
}
