# SPDX-License-Identifier: MIT
# Glint for Arch Linux, built from source (PLAN §18, ADR 0022). It isn't published anywhere (ADR 0021):
# build and install it from this folder with
#   makepkg -si
# It builds the newest commit of the repository below. install.sh is the other way to install Glint.
pkgname=glint
pkgver=0.1.0
pkgrel=1
pkgdesc='Click the moment a color appears on screen (X11)'
arch=('x86_64')
url='https://github.com/Muk7tm/glint'
license=('MIT')
# The window links fontconfig and loads its X11 libraries at run time.
depends=('fontconfig' 'gcc-libs' 'glibc' 'libx11' 'libxcb' 'libxcursor' 'libxi' 'libxkbcommon-x11' 'libxrandr')
makedepends=('cargo' 'git')
optdepends=('rtkit: real-time priority for the engine'
            'xorg-server-xvfb: the latency test in More options')
source=("$pkgname::git+$url.git")
sha256sums=('SKIP')

pkgver() {
    cd "$pkgname"
    printf '%s.r%s.g%s' "$(sed -n 's/^version = "\(.*\)"$/\1/p' Cargo.toml | head -n 1)" \
        "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

prepare() {
    cd "$pkgname"
    export RUSTUP_TOOLCHAIN=stable
    cargo fetch --locked --target "$(rustc -vV | sed -n 's/^host: //p')"
}

build() {
    cd "$pkgname"
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR=target
    # The engine apart from the window, so the window's winit doesn't switch on x11rb's libxcb
    # loading for the engine too (PLAN §14).
    cargo build --frozen --profile dist -p glint-engine -p glint-ctl -p glint-lab
    cargo build --frozen --profile dist -p glint-ui
}

package() {
    cd "$pkgname"
    local b
    for b in glint glintd glint-ctl glint-lab; do
        install -Dm755 "target/dist/$b" "$pkgdir/usr/bin/$b"
    done
    install -Dm644 assets/glint.desktop "$pkgdir/usr/share/applications/glint.desktop"
    install -Dm644 assets/glint.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/glint.svg"
    install -Dm644 packaging/systemd/glintd.service "$pkgdir/usr/lib/systemd/user/glintd.service"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
